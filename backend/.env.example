# Django Configuration
DJANGO_SECRET_KEY=change-me-to-a-strong-random-key
DEBUG=True

# Database Configuration
# Set USE_MYSQL=True to use MySQL instead of SQLite
USE_MYSQL=False

# MySQL Configuration (only used if USE_MYSQL=True)
MYSQL_DATABASE=analyticore_db
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_HOST=localhost
MYSQL_PORT=3306

# Allowed Hosts (comma-separated, use * for development only)
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS Configuration
# Comma-separated list of allowed origins (use * for development only)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# Celery Configuration (Redis)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Stripe Configuration (Payment Processing)
STRIPE_PUBLIC_KEY=pk_test_your-public-key
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Web Push Notifications (VAPID)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# Google Sheets Integration
GOOGLE_SHEETS_REDIRECT_URI=http://localhost:8000/api/integrations/google-sheets/callback
GOOGLE_SHEETS_CLIENT_ID=your-google-sheets-client-id
GOOGLE_SHEETS_CLIENT_SECRET=your-google-sheets-client-secret

# Google Drive Configuration
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8000/api/integrations/google-drive/callback
GOOGLE_DRIVE_CLIENT_ID=your-google-drive-client-id
GOOGLE_DRIVE_PROJECT_ID=your-google-project-id
GOOGLE_DRIVE_CLIENT_SECRET=your-google-drive-client-secret
GOOGLE_DRIVE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_DRIVE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_DRIVE_AUTH_PROVIDER_CERTIFICATE_URL=https://www.googleapis.com/oauth2/v1/certs

# OAuth Session Data URL (for Google OAuth callback)
OAUTH_SESSION_URL=https://demobackend.emergentagent.com/auth/v1/env/oauth/session-data
